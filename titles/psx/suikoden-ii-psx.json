{
  "id": "suikoden-ii-psx",
  "name": "Suikoden II",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Suikoden II.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/suikoden-ii-recomp",
  "rom_identity": {
    "crc32": [
      "7fbe0579"
    ],
    "md5": [
      "d0e75f47e4b2451339a5f13ad821ca5d"
    ],
    "sha1": [
      "123ad3a15b3f634afd2ba0144405f9d156417907"
    ],
    "sha256": [
      "acf1c55394797c4ef33bdb297cb4fcdefeb4885be84928ed5a82a0d7d3fcd472"
    ],
    "disc_serials": [
      "SLUS-00958"
    ],
    "sizes": [
      513907296
    ],
    "filenames": [
      "Suikoden II (USA).cue",
      "Suikoden II (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/suikoden-ii-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "suikoden-ii-recomp",
  "launch": {
    "linux": "Suikoden_II",
    "windows": "Suikoden_II.exe",
    "macos": "Suikoden_II"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.3.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/suikoden-ii-recomp",
      "ref": "v0.1.3"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Suikoden II",
    "game_version": "0.1.3",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
