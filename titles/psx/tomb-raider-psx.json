{
  "id": "tomb-raider-psx",
  "name": "Tomb Raider",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Tomb Raider.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/tomb-raider-recomp",
  "rom_identity": {
    "crc32": [
      "93f4f732"
    ],
    "md5": [
      "786a284ef28e71336debce138e5376ae"
    ],
    "sha1": [
      "204a8f248ef4b8a8ab0571b49427269938fd6a5f"
    ],
    "sha256": [
      "737e3182fb128c9f9f23935967e96263f9e1fd2db0541faff4a9297779580593"
    ],
    "disc_serials": [
      "SLUS-00152"
    ],
    "sizes": [
      343417872
    ],
    "filenames": [
      "Tomb Raider (USA) (Rev 6).cue",
      "Tomb Raider (USA) (Rev 6) (Track 01).bin"
    ],
    "track_counts": [
      57
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/tomb-raider-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "tomb-raider-recomp",
  "launch": {
    "linux": "tomb_raider",
    "windows": "tomb_raider.exe",
    "macos": "tomb_raider"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/tomb-raider-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
