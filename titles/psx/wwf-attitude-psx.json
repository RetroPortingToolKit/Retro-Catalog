{
  "id": "wwf-attitude-psx",
  "name": "WWF Attitude",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for WWF Attitude.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/wwf-attitude-recomp",
  "rom_identity": {
    "crc32": [
      "af1e14f6"
    ],
    "md5": [
      "61e9a866d16deebd49aa60e4648d2a71"
    ],
    "sha1": [
      "8239731b28a8175d4263a6e7532dd2f29f3c5f8c"
    ],
    "sha256": [
      "52edacb7438b88ec113741a2ac899985a11247b46015fcab834a8dd0607d21f8"
    ],
    "disc_serials": [
      "SLUS-00831"
    ],
    "sizes": [
      654714480
    ],
    "filenames": [
      "WWF Attitude (USA).cue",
      "WWF Attitude (USA) (Track 01).bin"
    ],
    "track_counts": [
      2
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/wwf-attitude-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "wwf-attitude-recomp",
  "launch": {
    "linux": "wwf_attitude",
    "windows": "wwf_attitude.exe",
    "macos": "wwf_attitude"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/wwf-attitude-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "WWF Attitude",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
