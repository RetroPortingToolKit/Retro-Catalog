{
  "id": "g-darius-psx",
  "name": "G. Darius",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for G. Darius.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/g-darius-recomp",
  "rom_identity": {
