{
  "id": "wwf-war-zone-psx",
  "name": "WWF War Zone",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for WWF War Zone.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/wwf-war-zone-recomp",
  "rom_identity": {
    "crc32": [
      "c8d3cba1"
    ],
    "md5": [
      "079eb92dc140978722335d7209e2506a"
    ],
    "sha1": [
      "f22bb78d8cc6e2313852764b55fd0c195e6220ce"
    ],
    "sha256": [
      "230783eb1a5bba552eda082fa45c650114c8545f272707821d7c8517187a7c76"
    ],
    "disc_serials": [
      "SLUS-00495"
    ],
    "sizes": [
      655514160
    ],
    "filenames": [
      "WWF War Zone (USA) (Rev 1).cue",
      "WWF War Zone (USA) (Rev 1) (Track 01).bin"
    ],
    "track_counts": [
      2
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/wwf-war-zone-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "wwf-war-zone-recomp",
  "launch": {
    "linux": "wwf_war_zone",
    "windows": "wwf_war_zone.exe",
    "macos": "wwf_war_zone"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/wwf-war-zone-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "WWF War Zone",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
