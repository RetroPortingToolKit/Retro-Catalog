    "github": "alexbeavs-ps1-ports/jersey-devil-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "jersey-devil-recomp",
  "launch": {
    "linux": "jersey_devil",
    "windows": "jersey_devil.exe",
    "macos": "jersey_devil"
  },
