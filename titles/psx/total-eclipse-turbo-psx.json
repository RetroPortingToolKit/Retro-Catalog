{
  "id": "total-eclipse-turbo-psx",
  "name": "Total Eclipse Turbo",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Total Eclipse Turbo.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/total-eclipse-turbo-recomp",
  "rom_identity": {
    "crc32": [
      "4cfeb6b5"
    ],
    "md5": [
      "c839f2af2ccbd50de73ed0ad6920d0fd"
    ],
    "sha1": [
      "bcf314d5191047135945d23f7f155a5ea5434b5f"
    ],
