{
  "id": "croc-2-psx",
  "name": "Croc 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Croc 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/croc-2-recomp",
  "rom_identity": {
    "crc32": [
      "0b9ee3bf"
    ],
    "md5": [
      "f7c26ff77d81fbde3bd20a3a55b413e4"
    ],
    "sha1": [
      "fee4318d38801d0eac6e32c951238be81ec1c70c"
    ],
    "sha256": [
      "3d264234fa1530e7e6dfc54e136f0f734dfe32f2faf8662067186cce4f57c256"
    ],
    "disc_serials": [
      "SLUS-00634"
    ],
    "sizes": [
      694472688
    ],
    "filenames": [
      "Croc 2 (USA).cue",
      "Croc 2 (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/croc-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "croc-2-recomp",
  "launch": {
    "linux": "croc_2",
    "windows": "croc_2.exe",
    "macos": "croc_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/croc-2-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
