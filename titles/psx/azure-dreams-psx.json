{
  "id": "azure-dreams-psx",
  "name": "Azure Dreams",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Azure Dreams.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/azure-dreams-recomp",
  "rom_identity": {
    "crc32": [
      "7b0c5f60"
    ],
    "md5": [
      "9f0afe31a2993af90e43a5ff3139e331"
    ],
    "sha1": [
      "fab68454be5e4e48f7a43ac797cc8c47325c6a20"
    ],
    "sha256": [
      "2d6843c42ca595687b3780e20ab8c8873705ccead5c8bbc0b69d1fa70bc00a90"
    ],
    "disc_serials": [
      "SLUS-00614"
    ],
    "sizes": [
      298576992
    ],
    "filenames": [
      "Azure Dreams (USA).cue",
      "Azure Dreams (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/azure-dreams-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "azure-dreams-recomp",
  "launch": {
    "linux": "Azure_Dreams",
    "windows": "Azure_Dreams.exe",
    "macos": "Azure_Dreams"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.3.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/azure-dreams-recomp",
      "ref": "v0.1.3"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Azure Dreams",
    "game_version": "0.1.3",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
