  "release": {
    "github": "alexbeavs-ps1-ports/descent-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "descent-recomp",
  "launch": {
    "linux": "descent",
    "windows": "descent.exe",
