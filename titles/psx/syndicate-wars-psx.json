{
  "id": "syndicate-wars-psx",
  "name": "Syndicate Wars",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Syndicate Wars.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/syndicate-wars-recomp",
  "rom_identity": {
    "crc32": [
      "c877b304"
    ],
    "md5": [
      "ddaab82f42c2e2fc9001af4cb43d71eb"
    ],
    "sha1": [
      "1876f4a97c8c0d30a6d895525484e9c6b11f4ee8"
    ],
    "sha256": [
      "6668f92c7609fc166f464c6ba533937067114cf3c7f9888aad76a9952f7a1cd9"
    ],
    "disc_serials": [
      "SLUS-00262"
    ],
    "sizes": [
      276153024
    ],
    "filenames": [
      "Syndicate Wars (USA).cue",
      "Syndicate Wars (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/syndicate-wars-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "syndicate-wars-recomp",
  "launch": {
    "linux": "syndicate_wars",
    "windows": "syndicate_wars.exe",
    "macos": "syndicate_wars"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/syndicate-wars-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
