{
  "id": "rollcage-psx",
  "name": "Rollcage",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Rollcage.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/rollcage-recomp",
  "rom_identity": {
    "crc32": [
      "295ce423"
    ],
    "md5": [
      "2386b48c3b480c0cd17df5dbbb6d7337"
    ],
    "sha1": [
      "8b40c3f2942c999957b86640c80504cddaf9f1fd"
    ],
    "sha256": [
      "fe4ce429795623bf9c840cd4187f203adcc3e9bf29e9c0fc531a037a4edeb689"
    ],
    "disc_serials": [
      "SLUS-00800"
    ],
    "sizes": [
      153129312
    ],
    "filenames": [
      "Rollcage (USA).cue",
      "Rollcage (USA) (Track 01).bin"
    ],
    "track_counts": [
      16
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/rollcage-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "rollcage-recomp",
  "launch": {
    "linux": "rollcage",
    "windows": "rollcage.exe",
    "macos": "rollcage"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/rollcage-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Rollcage",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
