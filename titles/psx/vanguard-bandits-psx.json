      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "vanguard-bandits-recomp",
  "launch": {
    "linux": "vanguard_bandits",
    "windows": "vanguard_bandits.exe",
    "macos": "vanguard_bandits"
