{
  "id": "one-psx",
  "name": "One",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for One.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/one-recomp",
  "rom_identity": {
    "crc32": [
      "762ecbf6"
    ],
    "md5": [
      "265b5570a13d12d717724b4414544d60"
    ],
    "sha1": [
      "015c0bee311f711733df05755e51d4d2dba4534d"
    ],
    "sha256": [
      "580b170991d11aea0a48b64d3f35084906b308133a29909715c562b69978ba6a"
    ],
    "disc_serials": [
      "SLUS-00469"
    ],
    "sizes": [
      60448752
    ],
    "filenames": [
      "One (USA).cue",
      "One (USA) (Track 01).bin"
    ],
    "track_counts": [
      5
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/one-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "one-recomp",
  "launch": {
    "linux": "one",
    "windows": "one.exe",
    "macos": "one"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/one-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
