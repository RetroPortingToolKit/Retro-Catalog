  "release": {
    "github": "alexbeavs-ps1-ports/destruction-derby-raw-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "destruction-derby-raw-recomp",
  "launch": {
    "linux": "Destruction_Derby_Raw",
    "windows": "Destruction_Derby_Raw.exe",
    "macos": "Destruction_Derby_Raw"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.3.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/destruction-derby-raw-recomp",
      "ref": "v0.1.3"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
