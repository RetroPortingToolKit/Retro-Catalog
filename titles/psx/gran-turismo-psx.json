{
  "id": "gran-turismo-psx",
  "name": "Gran Turismo",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Gran Turismo.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/gran-turismo-recomp",
  "rom_identity": {
    "crc32": [
      "2b3845aa"
    ],
    "md5": [
      "a8ce602f3a846adbbfae7770cd33afab"
    ],
    "sha1": [
      "5433c55806f7cd5ca2e42a6c39ff816d442ed6b6"
    ],
    "sha256": [
      "e1ba7def96b7f213637fa82658b53c34a3a5f6c54df7d7e5ab9c3f53a2d41f03"
    ],
    "disc_serials": [
      "SCUS-94194"
    ],
    "sizes": [
      693668304
    ],
    "filenames": [
      "Gran Turismo (USA) (Rev 1).cue",
      "Gran Turismo (USA) (Rev 1).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/gran-turismo-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "gran-turismo-recomp",
  "launch": {
    "linux": "gran_turismo",
    "windows": "gran_turismo.exe",
    "macos": "gran_turismo"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/gran-turismo-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Gran Turismo",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
