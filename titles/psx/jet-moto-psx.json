{
  "id": "jet-moto-psx",
  "name": "Jet Moto",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Jet Moto.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/jet-moto-recomp",
  "rom_identity": {
    "crc32": [
      "bda32b8d"
    ],
    "md5": [
      "a8c6041f61d64eab2baf669305ce3ea5"
    ],
    "sha1": [
      "f4e9e132dbbc44a628d637efc8f40099db294332"
    ],
    "sha256": [
      "4c75bbfa12678d93e38c165ab59cadbd96ad7060d22d189b4b7db64f489482bb"
    ],
    "disc_serials": [
      "SCUS-94309"
    ],
    "sizes": [
      80405472
    ],
    "filenames": [
      "Jet Moto (USA).cue",
      "Jet Moto (USA) (Track 01).bin"
    ],
    "track_counts": [
      14
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/jet-moto-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "jet-moto-recomp",
  "launch": {
    "linux": "jet_moto",
    "windows": "jet_moto.exe",
    "macos": "jet_moto"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/jet-moto-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Jet Moto",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
