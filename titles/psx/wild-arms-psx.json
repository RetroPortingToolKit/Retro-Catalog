  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Wild Arms.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/wild-arms-recomp",
  "rom_identity": {
    "crc32": [
      "53a5248c"
    ],
    "md5": [
      "19f6de83eb8b7525d7bf8eb27566ce30"
    ],
    "sha1": [
      "428a3678e42c0660697bf43643db1aa566f4821b"
    ],
    "sha256": [
      "c5345130e72b1b214c62f708ebb6ca3d2d60727381781ec6b4e1f4bfcf89674e"
    ],
    "disc_serials": [
      "SCUS-94608"
    ],
    "sizes": [
      637163856
    ],
    "filenames": [
      "Wild Arms (USA).cue",
