{
  "id": "urban-chaos-psx",
  "name": "Urban Chaos",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Urban Chaos.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/urban-chaos-recomp",
  "rom_identity": {
    "crc32": [
      "239c0746"
    ],
    "md5": [
      "c9b4e03de8dd5c1fb799fc56e5cf031a"
    ],
    "sha1": [
      "f6608f6ec4128366161f1aa99c6a8b69d76150fe"
    ],
    "sha256": [
      "fc70e4c0273725a4d810cf99542923b0d06905f592c61133d3e2b4ebbe1a79b6"
    ],
    "disc_serials": [
      "SLUS-01019"
    ],
    "sizes": [
      616096992
    ],
    "filenames": [
      "Urban Chaos (USA).cue",
      "Urban Chaos (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/urban-chaos-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "urban-chaos-recomp",
  "launch": {
    "linux": "urban_chaos",
    "windows": "urban_chaos.exe",
    "macos": "urban_chaos"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/urban-chaos-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
