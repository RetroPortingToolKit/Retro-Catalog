    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "tiny-tank-recomp",
  "launch": {
    "linux": "tiny_tank",
    "windows": "tiny_tank.exe",
