{
  "id": "shadow-tower-psx",
  "name": "Shadow Tower",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Shadow Tower.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/shadow-tower-recomp",
  "rom_identity": {
    "crc32": [
      "6bc061de"
    ],
    "md5": [
      "43a13b3c105761bd11d1b700f00e778d"
    ],
    "sha1": [
      "df441bf08b7079f8b3d36f1188f7eedd8cb73c50"
    ],
    "sha256": [
      "420420cee70eec9d6b4c81dcf6e16494f72fc3976a93fcbe4076a7336c659adb"
    ],
    "disc_serials": [
      "SLUS-00863"
    ],
    "sizes": [
      488105856
    ],
    "filenames": [
      "Shadow Tower (USA).cue",
      "Shadow Tower (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/shadow-tower-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "shadow-tower-recomp",
  "launch": {
    "linux": "shadow_tower",
    "windows": "shadow_tower.exe",
    "macos": "shadow_tower"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/shadow-tower-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
