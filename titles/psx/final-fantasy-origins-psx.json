{
  "id": "final-fantasy-origins-psx",
  "name": "Final Fantasy Origins",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Final Fantasy Origins.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/final-fantasy-origins-recomp",
  "rom_identity": {
    "crc32": [
      "7daa9f2f"
    ],
    "md5": [
      "03885810a2a577fa47dcf6c58dea75c0"
    ],
    "sha1": [
      "057cc9316529c873070faad72f466d9aa0f7a852"
    ],
    "sha256": [
      "e5b38ecde6c66f574434f6adf3f3be58e831209a9a51d58aec89f4740b127b60"
    ],
    "disc_serials": [
      "SLUS-01541"
    ],
    "sizes": [
      589557024
    ],
    "filenames": [
      "Final Fantasy Origins (USA) (Rev 1).cue",
      "Final Fantasy Origins (USA) (Rev 1).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/final-fantasy-origins-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "final-fantasy-origins-recomp",
  "launch": {
    "linux": "final_fantasy_origins",
    "windows": "final_fantasy_origins.exe",
    "macos": "final_fantasy_origins"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/final-fantasy-origins-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
