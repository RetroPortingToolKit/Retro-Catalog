{
  "id": "defcon-5-psx",
  "name": "Defcon 5",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Defcon 5.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/defcon-5-recomp",
  "rom_identity": {
    "crc32": [
      "8426bc38"
    ],
    "md5": [
      "606fdb24f57a9dd2bfbe9955ab1afb4b"
    ],
    "sha1": [
      "a82dc5a55cbd0e02f27485a8d3655ee27436adb7"
    ],
    "sha256": [
      "f2c8a7e4be3e69d1bc4dce6d981d316dd910c6f58f5f27a4f5110087c7795db5"
    ],
    "disc_serials": [
      "SLES-00081"
    ],
    "sizes": [
      372086400
    ],
    "filenames": [
      "Defcon 5 (Europe).cue",
      "Defcon 5 (Europe) (Track 01).bin"
    ],
    "track_counts": [
      3
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/defcon-5-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "defcon-5-recomp",
  "launch": {
    "linux": "defcon_5",
    "windows": "defcon_5.exe",
    "macos": "defcon_5"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH5552 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/defcon-5-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "bios_identity": {
    "required": true,
    "crc32": [
      "d786f0b9"
    ],
    "md5": [
      "32736f17079d0b2b7024407c39bd3050"
    ],
