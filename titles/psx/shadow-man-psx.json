{
  "id": "shadow-man-psx",
  "name": "Shadow Man",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Shadow Man.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/shadow-man-recomp",
  "rom_identity": {
    "crc32": [
      "91079460"
    ],
    "md5": [
      "763cd348b7f8da79963f97d05c19fb65"
    ],
    "sha1": [
      "4ad8a79eb29ef7b322051743d6aba645a347f403"
    ],
    "sha256": [
      "0f4bca2a9b96504829dcf15144218aa2f1533f1a9a296aa6ba2a22050e4c36d6"
    ],
    "disc_serials": [
      "SLUS-00895"
    ],
    "sizes": [
      534042768
    ],
    "filenames": [
      "Shadow Man (USA).cue",
      "Shadow Man (USA) (Track 01).bin"
    ],
    "track_counts": [
      2
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/shadow-man-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "shadow-man-recomp",
  "launch": {
    "linux": "shadow_man",
    "windows": "shadow_man.exe",
    "macos": "shadow_man"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/shadow-man-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
