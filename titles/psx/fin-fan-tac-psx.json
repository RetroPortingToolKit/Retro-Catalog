      "9dcb538305e6cfe52ce4da9d762612b4"
    ],
    "sha1": [
      "2b5d4db3229cdc7bbd0358b95fcba33dddae8bba"
    ],
    "sha256": ["29e63bb6d2e7b842fe87f7c0ee03b7076681c34bcc47095cca27ec53236bf4f9"],
    "disc_serials": [
      "SCUS-94221"
    ],
    "sizes": [
      541315152
    ],
    "filenames": [
      "Final Fantasy Tactics (USA).cue",
      "Final Fantasy Tactics (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "NJH-1001/FinFanTacRecomp",
    "asset_glob": {
      "linux": "*linux*",
      "windows": "*windows*",
      "macos": "*macos*"
    }
  },
  "install_dir_name": "FinFanTacRecomp",
  "launch": {
    "linux": "Final_Fantasy_Tactics_Recompiled",
    "windows": "Final_Fantasy_Tactics_Recompiled.exe",
    "macos": "Final_Fantasy_Tactics_Recompiled"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "notes": "Digests from the author's probe_disc output (catalog_identity.json / game.toml[prepare_disc] / README); an unsourced md5/sha256 pair from the 2026-09-03 submission was dropped. Linux/macOS assets were added to v0.1.0 after the submission probe ran. CMake sets PSX_NETPLAY OFF (single-player), so no netplay block.",
  "build": {
    "enabled": true,
    "source": {
      "github": "NJH-1001/FinFanTacRecomp",
      "ref": "main"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
