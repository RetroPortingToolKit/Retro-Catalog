{
  "id": "gex-psx",
  "name": "Gex",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Gex.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/gex-recomp",
  "rom_identity": {
    "crc32": [
      "5982a667"
    ],
    "md5": [
      "a931a7cf6786ccf5d8b6d8b8b86c519a"
    ],
    "sha1": [
      "78cd41e04ae48e01c8950c73d0329bc791dde087"
    ],
    "sha256": [
      "6721998eaf0972721535657d355bc5e2de425f296162e104edc83cd2f5ad4ce5"
    ],
    "disc_serials": [
      "SLUS-00042"
    ],
    "sizes": [
      216496896
    ],
    "filenames": [
      "Gex (USA).cue",
      "Gex (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/gex-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "gex-recomp",
  "launch": {
    "linux": "gex",
    "windows": "gex.exe",
    "macos": "gex"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/gex-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
