{
  "id": "jet-moto-2-psx",
  "name": "Jet Moto 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Jet Moto 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/jet-moto-2-recomp",
  "rom_identity": {
    "crc32": [
      "18f70153"
    ],
    "md5": [
      "ef5291897854b388cd1fb6c35f5e79cc"
    ],
    "sha1": [
      "4b345c4c821a0e2b7a072869628ede63c6a0a410"
    ],
    "sha256": [
      "0effb6c62d1680416cae186488cd7c3be7d20ec2fd5b88e2dc2cbf12b4de5fcf"
    ],
    "disc_serials": [
      "SCUS-94167"
    ],
    "sizes": [
      139565328
    ],
    "filenames": [
      "Jet Moto 2 (USA).cue",
      "Jet Moto 2 (USA) (Track 01).bin"
    ],
    "track_counts": [
      17
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/jet-moto-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "jet-moto-2-recomp",
  "launch": {
    "linux": "jet_moto_2",
    "windows": "jet_moto_2.exe",
    "macos": "jet_moto_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/jet-moto-2-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
