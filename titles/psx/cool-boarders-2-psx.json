{
  "id": "cool-boarders-2-psx",
  "name": "Cool Boarders 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Cool Boarders 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/cool-boarders-2-recomp",
  "rom_identity": {
    "crc32": [
      "467c37cd"
    ],
    "md5": [
      "641ea195e364eca98579f9a47cf0c796"
    ],
    "sha1": [
      "a6e71a783e06e6862c2d406eb8dc885201aa6108"
    ],
    "sha256": [
      "9fa6ac71924e178e86722c5304c99a9f1543f90c62e62ce4580efe1e59d6731a"
    ],
    "disc_serials": [
      "SCUS-94358"
    ],
    "sizes": [
      154759248
    ],
    "filenames": [
      "Cool Boarders 2 (USA).cue",
      "Cool Boarders 2 (USA) (Track 01).bin"
    ],
    "track_counts": [
      21
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/cool-boarders-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "cool-boarders-2-recomp",
  "launch": {
    "linux": "cool_boarders_2",
    "windows": "cool_boarders_2.exe",
    "macos": "cool_boarders_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/cool-boarders-2-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
