{
  "id": "silhouette-mirage-psx",
  "name": "Silhouette Mirage",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Silhouette Mirage.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/silhouette-mirage-recomp",
  "rom_identity": {
    "crc32": [
      "bedcdbfa"
    ],
    "md5": [
      "916eab42e8b05a1425a86156c1ed2b78"
    ],
    "sha1": [
      "9e37436575aac7454f6e113aa22fdbf2ab235773"
    ],
    "sha256": [
      "a7bc102751b52eeeb72b35f45d9aadbf0f4de71a224cdbb2f4547a6aed9ed364"
    ],
    "disc_serials": [
      "SLUS-00728"
    ],
    "sizes": [
      300218688
    ],
    "filenames": [
      "Silhouette Mirage (USA).cue",
      "Silhouette Mirage (USA) (Track 01).bin"
    ],
    "track_counts": [
      26
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/silhouette-mirage-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "silhouette-mirage-recomp",
  "launch": {
    "linux": "silhouette_mirage",
    "windows": "silhouette_mirage.exe",
    "macos": "silhouette_mirage"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/silhouette-mirage-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
