{
  "id": "gunship-psx",
  "name": "Gunship",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Gunship.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/gunship-recomp",
  "rom_identity": {
    "crc32": [
      "e6e5b7c1"
    ],
    "md5": [
      "cecf8013fa05793923e8d49510f89f2a"
    ],
    "sha1": [
      "db077318072c2afffc2418f9b7b6130a2fa82095"
    ],
    "sha256": [
      "39d6a48b7a1e5fb93f0a19081f73de4edb9a64acb18f985dc1913cf06ec891a6"
    ],
    "disc_serials": [
      "SLUS-00313"
    ],
    "sizes": [
      108415440
    ],
    "filenames": [
      "Gunship (USA).cue",
      "Gunship (USA) (Track 01).bin"
    ],
    "track_counts": [
      8
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/gunship-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "gunship-recomp",
  "launch": {
    "linux": "gunship",
    "windows": "gunship.exe",
    "macos": "gunship"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/gunship-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
