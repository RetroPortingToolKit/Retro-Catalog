{
  "id": "jet-moto-3-psx",
  "name": "Jet Moto 3",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Jet Moto 3.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/jet-moto-3-recomp",
  "rom_identity": {
    "crc32": [
      "9dc795bb"
    ],
    "md5": [
      "66452e812a04154f48e5328167f5691d"
    ],
    "sha1": [
      "4e4cf0f4ddece08621d7230ac1dd0ed5601948bb"
    ],
