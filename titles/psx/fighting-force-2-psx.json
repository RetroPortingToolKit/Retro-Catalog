{
  "id": "fighting-force-2-psx",
  "name": "Fighting Force 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Fighting Force 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/fighting-force-2-recomp",
  "rom_identity": {
    "crc32": [
      "d0d4d156"
    ],
    "md5": [
      "1fec84e29b197b36837df1cb9c40dacc"
    ],
    "sha1": [
      "248cbccb0bfcb676f30471567494209b09b99e86"
    ],
    "sha256": [
      "ffbecd6a1fd34c1ffb41b84c893a986315091dbe1185570b8996932269261417"
    ],
    "disc_serials": [
      "SLUS-00934"
    ],
    "sizes": [
      376094208
    ],
    "filenames": [
      "Fighting Force 2 (USA).cue",
      "Fighting Force 2 (USA) (Track 01).bin"
    ],
    "track_counts": [
      2
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/fighting-force-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "fighting-force-2-recomp",
  "launch": {
    "linux": "fighting_force_2",
    "windows": "fighting_force_2.exe",
    "macos": "fighting_force_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/fighting-force-2-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
