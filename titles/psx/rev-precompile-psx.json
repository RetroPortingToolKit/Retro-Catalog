      "linux": "*linux*",
      "windows": "*windows*",
      "macos": "*macos*"
    }
  },
  "install_dir_name": "RevPRecompile",
  "launch": {
    "linux": "Revelations__Persona_Recompiled",
    "windows": "Revelations__Persona_Recompiled.exe",
