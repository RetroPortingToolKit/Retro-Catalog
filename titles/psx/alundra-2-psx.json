  "release": {
    "github": "alexbeavs-ps1-ports/alundra-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "alundra-2-recomp",
  "launch": {
    "linux": "alundra_2",
    "windows": "alundra_2.exe",
