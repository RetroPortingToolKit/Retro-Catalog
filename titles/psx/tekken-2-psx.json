{
  "id": "tekken-2-psx",
  "name": "Tekken 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Tekken 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/tekken-2-recomp",
  "rom_identity": {
    "crc32": [
      "c3c198c8"
    ],
    "md5": [
      "a707b8f7d66dfd2b4454bf13fe97dc88"
    ],
    "sha1": [
      "31fb932cabff950784b6e0a8d3b0f5d1c3922187"
    ],
    "sha256": [
      "fe861939e926f37a0f1ea5f7d35d44d04dd57e97031ef913dec5c36ae29bbbbe"
    ],
    "disc_serials": [
      "SLUS-00213"
    ],
    "sizes": [
      717922128
    ],
    "filenames": [
      "Tekken 2 (USA).cue",
      "Tekken 2 (USA) (Track 01).bin"
    ],
    "track_counts": [
      3
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/tekken-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "tekken-2-recomp",
  "launch": {
    "linux": "tekken_2",
    "windows": "tekken_2.exe",
    "macos": "tekken_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/tekken-2-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Tekken 2",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": [
      "lan",
      "ice"
    ],
    "match_caps_schema": "psx-v1"
  }
}
