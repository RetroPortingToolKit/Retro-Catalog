{
  "id": "pandemonium-psx",
  "name": "Pandemonium!",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Pandemonium!.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/pandemonium-recomp",
  "rom_identity": {
    "crc32": [
      "1294599d"
    ],
    "md5": [
      "9d82d4ab02f27e4bdee328364cb32a3d"
    ],
    "sha1": [
      "35938c910d26bf5a79e1c3058a794f1278f85960"
    ],
    "sha256": [
      "1aea9550e2d77e55f7454ddbf2ab8432c067aa1ed887a174ea6ce89e7094614d"
    ],
    "disc_serials": [
      "SLUS-00232"
    ],
    "sizes": [
      225314544
    ],
    "filenames": [
      "Pandemonium! (USA) (Rev 1).cue",
      "Pandemonium! (USA) (Rev 1) (Track 01).bin"
    ],
    "track_counts": [
      3
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/pandemonium-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "pandemonium-recomp",
  "launch": {
    "linux": "pandemonium",
    "windows": "pandemonium.exe",
    "macos": "pandemonium"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/pandemonium-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
