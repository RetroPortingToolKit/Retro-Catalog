{
  "id": "blasto-psx",
  "name": "Blasto",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Blasto.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/blasto-recomp",
  "rom_identity": {
    "crc32": [
      "9bd04ccf"
    ],
    "md5": [
      "425b95bfeb90e1a4e72d8db5ed77971c"
    ],
    "sha1": [
      "a74bc51d9bff5fc2ad5b6b4deec2001ce9dfc015"
    ],
    "sha256": [
      "98c81fd6235c02bceaa56659b61f8ffcafa4e6de3e3be59e6a3a8fec0bcc539b"
    ],
    "disc_serials": [
      "SCUS-94412"
    ],
    "sizes": [
      369548592
    ],
    "filenames": [
      "Blasto (USA).cue",
      "Blasto (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/blasto-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "blasto-recomp",
  "launch": {
    "linux": "blasto",
    "windows": "blasto.exe",
    "macos": "blasto"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/blasto-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
