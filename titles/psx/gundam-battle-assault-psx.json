      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "gundam-battle-assault-recomp",
  "launch": {
    "linux": "gundam_battle_assault",
    "windows": "gundam_battle_assault.exe",
    "macos": "gundam_battle_assault"
