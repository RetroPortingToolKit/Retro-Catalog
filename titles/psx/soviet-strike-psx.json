{
  "id": "soviet-strike-psx",
  "name": "Soviet Strike",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Soviet Strike.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/soviet-strike-recomp",
  "rom_identity": {
    "crc32": [
      "24aa590a"
    ],
    "md5": [
      "21547641df0bdf27dcab20773b471f92"
    ],
    "sha1": [
      "d0717a6c7982918c93c30877ac61762a9f7c65de"
    ],
    "sha256": [
      "21cb2d9a85d0edb69168a769d58aa8119c37a807d91c65d91431365f9aec534d"
    ],
    "disc_serials": [
      "SLUS-00061"
    ],
    "sizes": [
      622847232
    ],
    "filenames": [
      "Soviet Strike (USA) (Rev 1).cue",
      "Soviet Strike (USA) (Rev 1) (Track 01).bin"
    ],
    "track_counts": [
      2
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/soviet-strike-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "soviet-strike-recomp",
  "launch": {
    "linux": "soviet_strike",
    "windows": "soviet_strike.exe",
    "macos": "soviet_strike"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.0.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/soviet-strike-recomp",
      "ref": "v0.1.0"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
