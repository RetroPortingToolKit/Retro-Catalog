    "github": "alexbeavs-ps1-ports/saga-frontier-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "saga-frontier-2-recomp",
  "launch": {
    "linux": "saga_frontier_2",
    "windows": "saga_frontier_2.exe",
    "macos": "saga_frontier_2"
