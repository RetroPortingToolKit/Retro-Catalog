{
  "id": "digimon-world-2-psx",
  "name": "Digimon World 2",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Digimon World 2.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/digimon-world-2-recomp",
  "rom_identity": {
    "crc32": [
      "b0cd9681"
    ],
    "md5": [
      "e8ee6810a33c45273800df07628d816b"
    ],
    "sha1": [
      "d9cb009bc0006e901d8ab1365f764ab71da02115"
    ],
    "sha256": [
      "c8c8646d5c137cbd35115f954b97f812e8613c419a651a906962e9e9b48d586a"
    ],
    "disc_serials": [
      "SLUS-01193"
    ],
    "sizes": [
      461993952
    ],
    "filenames": [
      "Digimon World 2 (USA).cue",
      "Digimon World 2 (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/digimon-world-2-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "digimon-world-2-recomp",
  "launch": {
    "linux": "Digimon_World_2",
    "windows": "Digimon_World_2.exe",
    "macos": "Digimon_World_2"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.3.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/digimon-world-2-recomp",
      "ref": "v0.1.3"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
