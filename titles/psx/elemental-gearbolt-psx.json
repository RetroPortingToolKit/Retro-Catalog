  "description": "A native recompilation setup host for Elemental Gearbolt.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/elemental-gearbolt-recomp",
  "rom_identity": {
    "crc32": [
      "8a6d6287"
    ],
    "md5": [
      "ff5508c7b567650a15357ecf843c335a"
    ],
    "sha1": [
      "c3cd7720515020b55a10f680ab47a7bca1e2fc34"
