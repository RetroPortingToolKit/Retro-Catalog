{
  "id": "smurfs-the-psx",
  "name": "Smurfs, The",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Smurfs, The.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/smurfs-the-recomp",
  "rom_identity": {
    "crc32": [
      "d141f530"
    ],
    "md5": [
      "81317b3c5c244a1c8a611e27a8a3b6a0"
    ],
    "sha1": [
      "e37f205d2f5205473b7c2cf7f706f0b42b685d54"
    ],
