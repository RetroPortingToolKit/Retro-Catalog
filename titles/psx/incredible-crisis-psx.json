{
  "id": "incredible-crisis-psx",
  "name": "Incredible Crisis",
  "kind": "recomp",
  "platform": "psx",
  "description": "A native recompilation setup host for Incredible Crisis.",
  "homepage": "https://github.com/alexbeavs-ps1-ports/incredible-crisis-recomp",
  "rom_identity": {
    "crc32": [
      "9f87357b"
    ],
    "md5": [
      "4d51e2807dface60c09b3f10558b3b95"
    ],
    "sha1": [
      "024fc3ec2309809406b2663b753bf5c4f505cd5b"
    ],
    "sha256": [
      "763ac391c05c7ed23c236518f7d7be2654a47d08df99829b05573f5ca19ff1ba"
    ],
    "disc_serials": [
      "SLUS-01225"
    ],
    "sizes": [
      721377216
    ],
    "filenames": [
      "Incredible Crisis (USA).cue",
      "Incredible Crisis (USA).bin"
    ],
    "track_counts": [
      1
    ],
    "require_cue": true
  },
  "rom_extensions": [
    ".cue",
    ".bin"
  ],
  "release": {
    "github": "alexbeavs-ps1-ports/incredible-crisis-recomp",
    "asset_glob": {
      "windows": "*windows-x64.zip",
      "linux": "*linux-x64.zip",
      "macos": "*macos-*.zip"
    }
  },
  "install_dir_name": "incredible-crisis-recomp",
  "launch": {
    "linux": "Incredible_Crisis",
    "windows": "Incredible_Crisis.exe",
    "macos": "Incredible_Crisis"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "author_notes": "Setup kit: supply the listed CUE/BIN disc set and your own SCPH1001 BIOS dump.",
  "notes": "Track 01 digests measured from an owned disc set; serials and track counts from the repo's disc_set.json; launch name from the kit's EXE_NAME; release v0.1.2.",
  "build": {
    "enabled": true,
    "source": {
      "github": "alexbeavs-ps1-ports/incredible-crisis-recomp",
      "ref": "v0.1.2"
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "RetroPortingToolKit/RetroPorting-Toolchains",
      "min_version": "1.0.3",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build",
      "target": "psx-runtime",
      "config": "Release"
    }
  }
}
