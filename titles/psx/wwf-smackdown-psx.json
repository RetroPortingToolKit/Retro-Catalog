      "03f1e0396ea9e89006904c3b5e466a8762a5c3506e8132603f9ed43363b79f47"
    ],
    "disc_serials": [
      "SLUS-00927"
    ],
    "sizes": [
      593016816
    ],
    "filenames": [
      "WWF SmackDown! (USA).cue",
      "WWF SmackDown! (USA).bin"
    ],
